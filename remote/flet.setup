# Flet project structure
{name}/src/
{name}/assets/
{name}/assets/images/
{name}/assets/fonts/
{name}/tests/

# Main application files
{name}/src/main.py
{name}/pages/home.py
{name}/lib/

# Project configuration
{name}/pyproject.toml: @flet-pyproject
{name}/README.md @general-readme
{name}/.gitignore
{name}/.env
{name}/requirements.txt

[setup]
# Ask for configuration
ask "App name" default="${name}" var="app_name"
ask "Author name" default="Developer" var="author"
ask "Python version (3.8, 3.9, 3.10, 3.11, 3.12)" default="3.11" var="py_version"
ask "Flet version (latest, 0.21.0, 0.20.0)" default="latest" var="flet_version"

# Create asset files
makefile assets/themes/dark.json "{}"
makefile assets/themes/light.json "{}"

# Create requirements.txt with base content
makefile requirements.txt "# Flet dependencies\n# Add your requirements here\n"

# Edit requirements.txt to add flet
editfile requirements.txt append "flet${flet_version != "latest" ? "==" + flet_version : ""}"

# Also add some common development packages
editfile requirements.txt append "python-dotenv>=1.0.0"
editfile requirements.txt append "requests>=2.31.0"

# Add comment lines using prepend (could also use insert_after)
editfile requirements.txt prepend "# Auto-generated requirements for ${app_name}"

# Setup environment
makevenv ${py_version}

# Install from requirements.txt
installreq

# Install development dependencies
pkginstalldev pytest pytest-asyncio black flake8 mypy pre-commit

echo Project ${app_name} is ready!
echo Package: ${app_name}
echo Author: ${author}
echo Flet Version: ${flet_version}
echo
echo To run your app:
echo cd ${name}
echo source .venv/bin/activate  # or .venv\\Scripts\\activate on Windows
echo flet run src/main.py
echo
echo To build for mobile:
echo flet build apk  # Android
echo flet build ios   # iOS